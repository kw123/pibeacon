set argsCount [llength $argv]
set userID [lindex $argv 0 ] 
set password [lindex $argv 1 ] 
# the plugin passes empty strings in argv 0/1 and the real credentials in the environment,
# so they do not show up in the world readable "ps -ef" command line of this process.
# running this script by hand with userid/password as the first 2 arguments still works.
if {[info exists env(PIBEACON_UID)]} {set userID   $env(PIBEACON_UID)}
if {[info exists env(PIBEACON_PWD)]} {set password $env(PIBEACON_PWD)}
set authKeyOrPassword [lindex $argv 2 ] 
set ipNumber [lindex $argv 3 ] 
set timeout [lindex $argv 4 ] 

set timeout $timeout

if {$argsCount > 5} {spawn ssh [lindex $argv $argsCount-1 ] -o ConnectTimeout=20 $userID@$ipNumber} else {spawn ssh -o ConnectTimeout=20 $userID@$ipNumber}

if {$authKeyOrPassword == "assword"} { 
    expect {
        "(yes/no" { 
            send "yes\r"
            sleep 0.1
            expect "$authKeyOrPassword" { send "$password\r"}
        }    
        "$authKeyOrPassword" { 
            send "$password\r" 
        }
    }
}

expect "pi@" { 
	send "tail -1000 /var/log/pibeacon\r"
	sleep 1
	send "echo 'end token' > ~/pibeacon/temp/dummy\r"
}
expect "end token" {send "exit\r"}
set timeout 0.1
expect eof


